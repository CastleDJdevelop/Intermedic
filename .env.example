# Copia este archivo a .env.local y completa los valores para desarrollo local.
# En Vercel, estas mismas variables se configuran en Settings → Environment Variables
# (DATABASE_URL se agrega sola si usas la integración de Neon desde el Marketplace).

# Postgres (Neon) — requerida
DATABASE_URL=postgres://usuario:password@host/basededatos?sslmode=require

# Firma de la cookie de sesión — requerida, mínimo 16 caracteres.
# Genera una con: openssl rand -hex 32
SESSION_SECRET=

# --- Agente de WhatsApp (opcional, ver docs/WHATSAPP.md) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Opcional: si se agrega, el agente de WhatsApp responde usando Claude
# en vez de las respuestas fijas por defecto.
ANTHROPIC_API_KEY=
